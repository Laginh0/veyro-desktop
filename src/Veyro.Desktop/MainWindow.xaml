<Window x:Class="Veyro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veyro"
        Width="940"
        Height="760"
        MinWidth="780"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VeyroSurface}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#13253A">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" Background="White" CornerRadius="14">
                        <Image Source="Assets/veyro_logo_color.png" Margin="8" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="12,2,0,0">
                        <TextBlock Text="VEYRO" Foreground="White" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="DESKTOP" Foreground="#9FB8D4" FontSize="10" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,46,0,0">
                    <Border Background="#294766" CornerRadius="9" Padding="14,11">
                        <TextBlock Text="Visão geral" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="Dispositivos" Foreground="#7791AD" Margin="14,21,0,0" />
                    <TextBlock Text="Trust Hub" Foreground="#7791AD" Margin="14,21,0,0" />
                    <TextBlock Text="Configurações" Foreground="#7791AD" Margin="14,21,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="CANAL DIRETO SEGURO" Foreground="#7F9AB7" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Marcos 5 e 6" Foreground="#BED0E3" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="42,36,42,32">
                <TextBlock Text="Seu ecossistema, por perto." FontSize="30" FontWeight="Bold" Foreground="{StaticResource VeyroInk}" />
                <TextBlock Text="O Veyro prepara conexões diretas entre este notebook e seus dispositivos, sem depender de nuvem ou roteador."
                           Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left"
                           FontSize="15" LineHeight="23" TextWrapping="Wrap" Foreground="{StaticResource VeyroMuted}" />

                <Border Margin="0,28,0,0" Background="White" CornerRadius="14" Padding="24" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Este computador" FontSize="12" FontWeight="Bold" Foreground="{StaticResource VeyroBlue}" />
                            <TextBlock x:Name="DeviceNameText" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource VeyroInk}" />
                            <TextBlock x:Name="DeviceIdText" Margin="0,5,0,0" FontFamily="Consolas" Foreground="{StaticResource VeyroMuted}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#E8F6ED" CornerRadius="14" Padding="13,7" VerticalAlignment="Center">
                            <TextBlock Text="Identidade protegida" Foreground="#24633B" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="22" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Bluetooth Low Energy" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource VeyroInk}" />
                            <TextBlock Text="Descoberta e controle" Margin="0,4,0,0" Foreground="{StaticResource VeyroMuted}" />
                            <TextBlock x:Name="BleStatusText" Margin="0,18,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="22" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Wi-Fi Direct" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource VeyroInk}" />
                            <TextBlock Text="Canal direto de dados" Margin="0,4,0,0" Foreground="{StaticResource VeyroMuted}" />
                            <TextBlock x:Name="WifiDirectStatusText" Margin="0,18,0,0" FontWeight="SemiBold" />
                            <TextBlock x:Name="ActiveSessionsText" Text="0 sessões seguras" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource VeyroMuted}" />
                            <TextBlock x:Name="GroupStatusText" Text="Grupo: este computador é o coordenador"
                                       Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource VeyroMuted}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,18,0,0" Background="{StaticResource VeyroBlueSoft}" CornerRadius="14" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Transportes diretos" FontWeight="Bold" FontSize="16" Foreground="#173A63" />
                            <TextBlock x:Name="DiscoveryStatusText" Text="Preparando anúncio e varredura Bluetooth…"
                                       Margin="0,5,20,0" TextWrapping="Wrap" Foreground="#365675" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Minimizar para a bandeja" Click="HideToTray_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Dispositivos próximos" FontSize="17" FontWeight="Bold" Foreground="{StaticResource VeyroInk}" />
                            <TextBlock Grid.Row="1" Text="Presença Veyro detectada por BLE" Margin="0,4,0,12" Foreground="{StaticResource VeyroMuted}" />
                            <ListBox x:Name="NearbyDevicesList" Grid.Row="2" MinHeight="105" MaxHeight="160" BorderThickness="0" Background="#F7F9FC" SelectionChanged="NearbyDevicesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,6">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource VeyroInk}" />
                                            <TextBlock Text="{Binding Details}" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource VeyroMuted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="PairButton" Grid.Row="3" Content="Parear dispositivo" Margin="0,14,0,0" IsEnabled="False" Click="PairButton_Click" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Trust Hub" FontSize="17" FontWeight="Bold" Foreground="{StaticResource VeyroInk}" />
                            <TextBlock Grid.Row="1" Text="Identidades confirmadas por você" Margin="0,4,0,12" Foreground="{StaticResource VeyroMuted}" />
                            <ListBox x:Name="TrustedDevicesList" Grid.Row="2" MinHeight="105" MaxHeight="160" BorderThickness="0" Background="#F7F9FC" SelectionChanged="TrustedDevicesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,6">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource VeyroInk}" />
                                            <TextBlock Text="{Binding Details}" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource VeyroMuted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="RevokeButton" Grid.Row="3" Content="Revogar confiança" Margin="0,14,0,0" Background="#9A3434" IsEnabled="False" Click="RevokeButton_Click" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Margin="0,18,0,0" Background="White" CornerRadius="14" Padding="22" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Destinos" FontSize="17" FontWeight="Bold" Foreground="{StaticResource VeyroInk}" />
                            <TextBlock Text="Selecione um ou vários membros" Margin="0,4,0,10" Foreground="{StaticResource VeyroMuted}" />
                            <ListBox x:Name="FeatureDestinationsList" SelectionMode="Extended" MinHeight="105" MaxHeight="170"
                                     BorderThickness="0" Background="#F7F9FC">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,5">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource VeyroInk}" />
                                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource VeyroMuted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Compartilhar e consultar" FontSize="17" FontWeight="Bold" Foreground="{StaticResource VeyroInk}" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Enviar arquivos" Click="SendFiles_Click" Margin="0,0,8,8" />
                                <Button Content="Enviar clipboard" Click="SendClipboard_Click" Margin="0,0,8,8" />
                                <Button Content="Bateria e conexão" Click="SendDeviceState_Click" Margin="0,0,8,8" />
                                <Button Content="Ping" Click="Ping_Click" Margin="0,0,8,8" />
                            </WrapPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LinkTextBox" MinWidth="240" Padding="8" ToolTip="https://..." />
                                <Button Grid.Column="1" Content="Enviar link" Click="SendLink_Click" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Text="Integração do sistema" Margin="0,14,0,4" FontWeight="SemiBold" Foreground="{StaticResource VeyroInk}" />
                            <WrapPanel>
                                <Button Content="Notificações" Click="SyncNotifications_Click" Margin="0,0,8,8" />
                                <Button Content="▶ Mídia" Click="SendMedia_Click" CommandParameter="Play" Margin="0,0,8,8" />
                                <Button Content="⏸ Mídia" Click="SendMedia_Click" CommandParameter="Pause" Margin="0,0,8,8" />
                                <Button Content="Próxima" Click="SendMedia_Click" CommandParameter="Next" Margin="0,0,8,8" />
                                <Button Content="Apresentar" Click="SendPresentation_Click" CommandParameter="Start" Margin="0,0,8,8" />
                                <Button Content="Encerrar" Click="SendPresentation_Click" CommandParameter="Stop" Margin="0,0,8,8" />
                                <Button Content="Tela preta" Click="SendPresentation_Click" CommandParameter="Blackout" Margin="0,0,8,8" />
                            </WrapPanel>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SecureCommandCombo" DisplayMemberPath="DisplayName" />
                                <Button Grid.Column="1" Content="Enviar ação segura" Click="SendSecureCommand_Click" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="FeatureStatusText" Text="Recursos prontos"
                                       Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#365675" />
                            <TextBlock x:Name="RemoteStateText" Text="Nenhum estado remoto recebido"
                                       Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource VeyroMuted}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,18,0,0" Background="White" CornerRadius="14" Padding="22" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Permissões contextuais" FontSize="17" FontWeight="Bold" Foreground="{StaticResource VeyroInk}" />
                        <TextBlock Text="Regras independentes por dispositivo. “Perguntar” exige confirmação a cada ação recebida."
                                   Margin="0,4,0,12" TextWrapping="Wrap" Foreground="{StaticResource VeyroMuted}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="PermissionDeviceCombo" DisplayMemberPath="DisplayName"
                                      SelectionChanged="PermissionDeviceCombo_SelectionChanged" />
                            <ComboBox x:Name="PermissionFeatureCombo" Grid.Column="2" DisplayMemberPath="DisplayName"
                                      SelectionChanged="PermissionFeatureCombo_SelectionChanged" />
                            <ComboBox x:Name="PermissionPolicyCombo" Grid.Column="4" DisplayMemberPath="DisplayName"
                                      SelectionChanged="PermissionPolicyCombo_SelectionChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="DataPathText" Margin="2,20,0,0" FontSize="11" Foreground="#7A8490" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
